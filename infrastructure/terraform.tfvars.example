# Copy this to terraform.tfvars and fill in your values
# terraform.tfvars is gitignored - do not commit it

# Bedrock Knowledge Base ID for recipe search (required)
knowledge_base_id = ""

# AWS CLI profile (optional)
# aws_profile = "default"

# Cognito users to create (email => password)
# cognito_users = {
#   "user@example.com" = "YourPassword1!"
# }

# Cognito callback URLs (add your CloudFront domain after first deploy)
cognito_callback_urls = [
  "http://localhost:5173"
]
